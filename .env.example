# Copy file ini jadi ".env" lalu isi key kamu (jangan commit .env ke GitHub!)
GROQ_API_KEY=isi_key_groq_kamu_disini
# Opsional: ganti model Groq (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# BUAT DEPLOY VERCEL: YouTube memblokir ambil transcript dari IP server.
# Isi SALAH SATU key ini biar transcript otomatis jalan di Vercel
# (dua-duanya gratis, tanpa kartu):
# SUPADATA_API_KEY=isi_key_dari_supadata.ai             (100 kredit/bulan)
# TRANSCRIPT_API_KEY=isi_key_dari_transcriptapi.com     (100 kredit awal)
# Tanpa key ini, user tetap bisa tempel transcript manual di web-nya.
